#!/usr/bin/env python
"""
MSCodeBase pre-commit hook — автоматическая проверка перед коммитом.

Установлен: 3.4.0
Дата установки: 2026-09-04 11:19:11

Запускает:
1. verify_diary — проверка AGENT_DIARY.md
2. stale_detector — проверка дрейфа версий в доках
3. check_tool_names — semantic-гейт имён MCP-тулов
4. negative_controls — guard inventory (каждый guard умеет падать)
5. check_layer_boundaries — гейт трёх осей (Universal Engine)
6. architecture_linter — архитектурные инварианты (core→mcp, registry, циклы, stale-имена)
7. lock_guard — активные git-локи (advisory, exit 0)
8. check_known_issues — §4.8 R4: размер ≤ 300 строк + архивация старых записей
9. third_party_data — чужие данные/лицензии
10. parallel_sessions — чужой файл в индексе
11. ruff_gate — линтер
12. verification_gates — G1–G5 (scripts/gate_cli.py --selftest)
13. protocol_gate — секреты, удалённые ассерты, focus-маркеры (глобальный гейт протокола)
14. gitleaks — энтропийный секрет-скан staged-изменений (v8.30.1)
"""

import os
import subprocess
import sys
import time
import signal
from pathlib import Path

# Per-gate budget. 900s is the historical value (documented flakiness at 300s);
# overridable only to make the timeout path testable without a 15-minute wait.
GATE_TIMEOUT = int(os.environ.get("MSCB_PRECOMMIT_GATE_TIMEOUT", "900"))

# Indirection so a test can stub THIS module's spawn without patching the
# global `subprocess` module — a global patch leaks into every other test in
# the same worker (CI: 14 unrelated failures).
Popen = subprocess.Popen
_RUN = subprocess.run


def _spawn_kwargs() -> dict:
    """A gate must be a process-group leader, so a timeout can kill its tree."""
    if sys.platform == "win32":
        return {"creationflags": getattr(subprocess, "CREATE_NO_WINDOW", 0)
                | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)}
    return {"start_new_session": True}


def _kill_tree(proc) -> None:
    """Kill the gate and every descendant it spawned.

    proc.kill() alone kills only the direct child. Observed 2026-11-14: a
    timed-out commit left `verify_diary -> pytest tests/` running for 10+
    minutes; the orphan then competed with the next run and made a fast test
    look like an 11-minute hang. On Windows the tree needs taskkill /T; on
    POSIX the child is a session leader, so killpg reaches the group.
    """
    poll = getattr(proc, "poll", None)
    if poll is not None and poll() is not None:
        return
    pid = getattr(proc, "pid", None)
    if pid is not None:
        try:
            if sys.platform == "win32":
                _RUN(["taskkill", "/PID", str(pid), "/T", "/F"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     check=False, timeout=15)
            else:
                os.killpg(os.getpgid(pid), signal.SIGKILL)
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        proc.kill()
    except OSError:
        pass
    try:
        proc.communicate(timeout=10)
    except subprocess.TimeoutExpired:
        pass



# §9 п.9 (ENCODING SAFETY): при выводе emoji-строк из stdout скриптов
# (например, «📊 Итог: 20 ✅ / 1 ❌») в cp1251-консоль падает
# UnicodeEncodeError → hook фейлит коммит по ложной причине.
if sys.stdout.encoding != 'utf-8':
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')


def find_project_root() -> Path | None:
    """Resolve repo root by marker walk (works from any hook home).

    Ascends from the hook file until a directory containing .git or
    KNOWN_ISSUES.md is found. Returns None when no marker is found
    (fail-closed: the caller must refuse to pass, never silently skip).
    """
    start = Path(__file__).resolve().parent
    for candidate in [start, *start.parents]:
        if (candidate / ".git").exists() or (candidate / "KNOWN_ISSUES.md").is_file():
            return candidate
    return None


def run_script(script_path: str, label: str, extra_args: list[str] | None = None) -> bool:
    """Запускает скрипт и возвращает True если успешно."""
    project_root = find_project_root()
    if project_root is None:
        print(f"  ❌ {label}: project root not found (no .git / KNOWN_ISSUES.md markers)")
        return False
    script = project_root / script_path

    if not script.exists():
        print(f"  ⏭️  {label}: скрипт не найден ({script})")
        return True

    # Печатаем ДО запуска: гейт с большим бюджетом (verify_diary тянет полный
    # pytest) иначе выглядит как зависание — и его обходят через --no-verify.
    print(f"  ⏳ {label}: выполняется (бюджет {GATE_TIMEOUT}s)…", flush=True)
    _started = time.monotonic()
    # §5.16: Popen + communicate (не capture_output) — защита от pipe-deadlock
    # в фоновых потоках; encoding="utf-8" — декодирование stdout в utf-8.
    proc = Popen(
        [sys.executable, str(script), *(extra_args or [])],
        cwd=str(project_root),
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        encoding="utf-8",
        errors="replace",
        **_spawn_kwargs(),
    )
    # A timed-out gate is a verdict, not a claim about suite speed. The old
    # "~108-130s" note stopped being true as the suite grew to 2528 tests, and
    # on 2026-11-14 a loaded machine took 1092s for gate-zero. Keep the budget
    # generous; the correctness requirement is that the tree is killed.
    try:
        stdout, _ = proc.communicate(timeout=GATE_TIMEOUT)
    except subprocess.TimeoutExpired:
        # Раньше это было необработанное исключение: хук умирал с трейсбеком и
        # БЕЗ вердикта — его путали с «гейт сломан» и обходили через --no-verify.
        # Таймаут — это вердикт: называем гейт, который не ответил.
        _kill_tree(proc)
        print(f"  ❌ {label}: TIMEOUT >{GATE_TIMEOUT}s — гейт не ответил, вердикта нет",
              flush=True)
        return False
    if proc.returncode != 0:
        print(f"  ❌ {label}: exit {proc.returncode}", flush=True)
        if stdout:
            for line in stdout.splitlines()[-10:]:
                print(f"    {line}")
        return False
    print(f"  ✅ {label}: OK ({time.monotonic() - _started:.1f}s)", flush=True)
    return True


def _staged_files() -> list[str]:
    """Файлы, попавшие в этот коммит (staged, без удалённых).

    §5.16: Popen + communicate, а не capture_output — единый паттерн с гейтами.
    """
    try:
        proc = Popen(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            encoding="utf-8",
            errors="replace",
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        out, _ = proc.communicate(timeout=15)
    except (OSError, subprocess.SubprocessError):
        return []
    if proc.returncode != 0:
        return []
    return [line.strip() for line in (out or "").splitlines() if line.strip()]


def main():
    print("🔍 MSCodeBase pre-commit checks:", flush=True)
    all_ok = True

    # gate-zero тянет полный `pytest tests/`. Измерено 2026-10-03 на этой машине:
    # 36% за 600s, то есть ~1670s — бюджет гейта (900s) не выдерживает НИ ОДНОГО
    # коммита. Раньше это выглядело как «хук висит», и коммиты уходили в
    # --no-verify. Поэтому fast-режим: полный прогон остаётся за CI, а локальный
    # коммит говорит ВСЛУХ, что именно пропущено.
    #
    # 2026-11-07: полный прогон ~208 s (серийно). Доки не могут его сломать,
    # поэтому коммит БЕЗ единого .py/.pyi пропускает gate-zero автоматически —
    # именно так 5 документационных коммитов подряд стоили ~17 минут.
    staged = _staged_files()
    only_docs = bool(staged) and all(
        p.endswith((".md", ".txt", ".rst")) for p in staged
    )
    fast = os.environ.get("MSCB_PRECOMMIT_FAST") == "1"
    if only_docs and not fast:
        print(
            f"  ⚡ docs-only ({len(staged)} файлов: .md/.txt/.rst): "
            "gate-zero (полный pytest) пропущен — доки тесты не ломают.",
            flush=True,
        )
    diary_args = ["--skip-gate-zero"] if (fast or only_docs) else None
    if fast:
        print("  ⚠️  FAST: полный `pytest tests/` (gate-zero) ПРОПУЩЕН — "
              "покрытие этого коммита обязана взять CI.", flush=True)

    all_ok &= run_script("scripts/verify_diary.py", "verify_diary", diary_args)
    # --staged: гейт судит КОММИТ, а не всё рабочее дерево — иначе чужие
    # незастейдженные драфты параллельной сессии блокируют чужой коммит (§21).
    all_ok &= run_script("scripts/stale_detector.py", "stale_detector", ["--staged"])
    all_ok &= run_script("scripts/check_tool_names.py", "check_tool_names")
    all_ok &= run_script("scripts/negative_controls_runner.py", "negative_controls")
    all_ok &= run_script("scripts/check_layer_boundaries.py", "check_layer_boundaries")
    all_ok &= run_script("scripts/architecture_linter.py", "architecture_linter")
    all_ok &= run_script("scripts/lock_guard.py", "lock_guard (advisory)")
    all_ok &= run_script("scripts/check_known_issues.py", "check_known_issues")
    all_ok &= run_script("scripts/check_third_party_data.py", "third_party_data")
    all_ok &= run_script("scripts/check_parallel_sessions.py", "parallel_sessions")
    all_ok &= run_script("scripts/ruff_gate.py", "ruff_gate")

    # 11. verification_gates — G1 population / G2 referent / G3 generalization /
    #     G4 control (tools/verification/gates.py). rc=1 blocks the commit,
    #     rc=2 is advisory (not enough input to judge — never read as ALLOW,
    #     but also never blocks a commit on its own per §19.6).
    project_root = find_project_root()
    if project_root is None:
        print("  ❌ verification_gates: project root not found",
              flush=True)
        all_ok = False
    else:
        gate_args = ["scripts/gate_cli.py"]
        gate_env = dict(os.environ)
        gate_env["PYTHONUNBUFFERED"] = "1"
        print("  ⏳ verification_gates: выполняется (бюджет 120s)…", flush=True)
        gate_proc = Popen(
            [sys.executable, "-B", str(project_root / "scripts" / "gate_cli.py"), "--selftest"],
            cwd=str(project_root),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            encoding="utf-8",
            errors="replace",
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            env=gate_env,
        )
        try:
            _gate_stdout, _ = gate_proc.communicate(timeout=120)
        except subprocess.TimeoutExpired:
            gate_proc.kill()
            gate_proc.communicate()
            print("  ❌ verification_gates: TIMEOUT >120s — гейт не ответил",
                  flush=True)
            all_ok = False
        else:
            gate_rc = gate_proc.returncode
            if gate_rc == 1:
                print("  ❌ verification_gates: BLOCK — проверка не прошла",
                      flush=True)
                if _gate_stdout:
                    for line in _gate_stdout.splitlines()[-8:]:
                        print(f"    {line}", flush=True)
                all_ok = False
            elif gate_rc == 2:
                # UNKNOWN — advisory only, never blocks (§19.6 / P-01).
                print("  ⚠️  verification_gates: UNKNOWN — недостаточно входа для суждения",
                      flush=True)
                if _gate_stdout:
                    for line in _gate_stdout.splitlines()[-8:]:
                        print(f"    {line}", flush=True)
            else:
                print("  ✅ verification_gates: OK", flush=True)

    # 13. protocol_gate — глобальный гейт агентского протокола (вне репозитория).
    #     rc=1 BLOCK, rc=2 пустой вход (allow-empty/merge — не судит),
    #     rc=3 внутренняя ошибка. WARN печатаются, но не блокируют.
    if project_root is None:
        print("  ❌ protocol_gate: project root not found", flush=True)
        all_ok = False
    else:
        protocol_gate = Path(os.environ.get(
            "MSCB_PROTOCOL_GATE",
            str(Path.home() / ".config" / "opencode" / "scripts" / "precommit_gate.py"),
        ))
        if not protocol_gate.is_file():
            print(f"  ⏭️  protocol_gate: не найден ({protocol_gate}) — пропущен",
                  flush=True)
        else:
            print("  ⏳ protocol_gate: выполняется (бюджет 60s)…", flush=True)
            try:
                pg_proc = Popen(
                    [sys.executable, str(protocol_gate)],
                    cwd=str(project_root),
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    encoding="utf-8",
                    errors="replace",
                    creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
                )
                pg_out, pg_err = pg_proc.communicate(timeout=60)
            except subprocess.TimeoutExpired:
                pg_proc.kill()
                pg_proc.communicate()
                print("  ❌ protocol_gate: TIMEOUT >60s — гейт не ответил", flush=True)
                all_ok = False
            except OSError as exc:
                print(f"  ❌ protocol_gate: не запустился ({exc})", flush=True)
                all_ok = False
            else:
                lines = ((pg_out or "") + (pg_err or "")).splitlines()
                if pg_proc.returncode == 1:
                    print("  ❌ protocol_gate: BLOCK", flush=True)
                    for line in lines[-10:]:
                        print(f"    {line}")
                    all_ok = False
                elif pg_proc.returncode == 2:
                    print("  ⚠️  protocol_gate: пустой вход (allow-empty/merge) — не судит",
                          flush=True)
                elif pg_proc.returncode == 3:
                    print("  ❌ protocol_gate: внутренняя ошибка rc=3", flush=True)
                    for line in lines[-6:]:
                        print(f"    {line}")
                    all_ok = False
                else:
                    warned = [l for l in lines if l.startswith("WARN")]
                    print(f"  ✅ protocol_gate: OK ({len(warned)} WARN)", flush=True)
                    for line in warned[:20]:
                        print(f"    {line}")

    # 14. gitleaks — настоящий секрет-сканер (энтропия + правила, не regex по форме).
    #     Пин v8.30.1. Бинарник вне репозитория; если его нет — WARN, не блок:
    #     иначе коммит невозможен на машине без сканера (CI проверяет всегда).
    if project_root is None:
        print("  ❌ gitleaks: project root not found", flush=True)
        all_ok = False
    else:
        gitleaks = Path(os.environ.get(
            "MSCB_GITLEAKS",
            str(Path.home() / ".config" / "opencode" / "bin" / "gitleaks.exe"),
        ))
        if not gitleaks.is_file():
            print(f"  ⚠️  gitleaks: не найден ({gitleaks}) — секрет-скан пропущен", flush=True)
        else:
            print("  ⏳ gitleaks: выполняется (бюджет 60s)…", flush=True)
            try:
                gl_proc = Popen(
                    [str(gitleaks), "git", ".", "-c", ".gitleaks.toml",
                     "--staged", "--redact", "--no-banner"],
                    cwd=str(project_root),
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    encoding="utf-8",
                    errors="replace",
                    creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
                )
                gl_out, gl_err = gl_proc.communicate(timeout=60)
            except subprocess.TimeoutExpired:
                gl_proc.kill()
                gl_proc.communicate()
                print("  ❌ gitleaks: TIMEOUT >60s — гейт не ответил", flush=True)
                all_ok = False
            except OSError as exc:
                print(f"  ❌ gitleaks: не запустился ({exc})", flush=True)
                all_ok = False
            else:
                gl_lines = ((gl_out or "") + (gl_err or "")).splitlines()
                if gl_proc.returncode == 1:
                    print("  ❌ gitleaks: найден секрет в staged изменениях", flush=True)
                    for line in gl_lines[-8:]:
                        print(f"    {line}")
                    all_ok = False
                else:
                    print("  ✅ gitleaks: OK", flush=True)

    if not all_ok:
        print("\n❌ Pre-commit checks FAILED. Исправьте ошибки перед коммитом.", flush=True)
        sys.exit(1)
    print("\n✅ All pre-commit checks passed.", flush=True)
    sys.exit(0)


if __name__ == "__main__":
    main()
