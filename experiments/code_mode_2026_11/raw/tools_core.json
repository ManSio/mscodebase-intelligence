 {
  "name": "investigate",
  "description": "hints: identifiers/terms the HOST extracted from the question.\n\nThe server is language-agnostic on purpose: an agent that speaks\nChinese, Russian or English already knows the code-shaped names, so it\npasses them here instead of the server carrying a dictionary per\nlanguage. A hint also lifts the ask-for-identifier gate, because the\nquestion can now be answered exactly.\n",
  "inputSchema": {
   "properties": {
    "query": {
     "title": "Query",
     "type": "string"
    },
    "limit": {
     "default": 8,
     "title": "Limit",
     "type": "integer"
    },
    "project_root": {
     "default": "",
     "title": "Project Root",
     "type": "string"
    },
    "include_neighbours": {
     "default": false,
     "title": "Include Neighbours",
     "type": "boolean"
    },
    "rerank": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rerank"
    },
    "hints": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Hints"
    }
   },
   "required": [
    "query"
   ],
   "title": "executeArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "executeOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": true,
   "idempotentHint": true
  }
 },
