  "version_ignore_files": [
    "docs/en/SECURITY.md",
    "docs/en/INSTALL.md",
    "docs/en/SYSTEM_REQUIREMENTS.md"
  ],
  "severity_overrides": {
    "docs/ru/*": "warn",
    "docs/zh/*": "warn"
  }
