{
  "exclude_files": [
    "AGENT_DIARY.md",
    "DEV_DIARY.md",
    "EXPERIMENTS_LOG.md",
    "CHANGELOG.md",
    "KNOWN_ISSUES.md",
    "ISSUE.md",
    "WISDOM.md",
    "owp_rfc_001_v04.md",
    "owp_github_discussion_draft.md",
    "ARCLUX_AUDIT_2026-08-26.md"
