# MSCodeBase remote — переменные окружения (скопировать в .env).
# MSCODEBASE_REMOTE_TOKEN — ОБЯЗАТЕЛЕН для remote-режима: Bearer-token
# (Streamable HTTP auth). Пустое значение = access-gate выключен (не для сети!).
MSCODEBASE_REMOTE_TOKEN=change-me-strong-token

# Лимит запросов/сек на ключ remote-гейта (per-token + per-IP). <=0 = выключено.
MSCODEBASE_REMOTE_RATE_LIMIT_RPS=30.0

# Хост/порт внешнего llama.cpp embedder (опционально, Вариант C). По умолчанию
# движок использует ONNX in-process CPU fallback.
#LLAMA_CPP_HOST=embedder
#LLAMA_CPP_PORT=8080
